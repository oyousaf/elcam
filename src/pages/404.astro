---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="wrap py-20 md:py-32">
    <p class="eyebrow">Error 404</p>
    <h1 class="display-hero mt-4">We can't find that page</h1>
    <p class="mt-6 max-w-xl">It may have moved when the site was updated. Try our home page, or call us on <a href={site.phoneHref} class="font-bold text-brand underline">{site.phone}</a>.</p>
    <a href="/" class="btn btn-hivis mt-8">Go to the home page</a>
  </section>
</Base>
