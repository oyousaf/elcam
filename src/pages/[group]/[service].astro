---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RoomCrop from '../../components/RoomCrop.astro';
import Quote from '../../components/Quote.astro';
import CallBand from '../../components/CallBand.astro';
import { groups, site, type GroupKey } from '../../data/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => {
    const [group, service] = entry.id.split('/');
    return { params: { group, service }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const key = Astro.params.group as GroupKey;
const group = groups[key];
const related = (await getCollection('services'))
  .filter((s) => s.id.startsWith(`${key}/`) && s.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: group.label, item: new URL(`/${key}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title },
  ],
};
---
<Base title={entry.data.metaTitle} description={entry.data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  <nav aria-label="Breadcrumb" class="wrap pt-5">
    <ol class="crumbs">
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/${key}/`}>{group.label}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>

  <section class="wrap grid gap-10 pt-8 pb-12 lg:grid-cols-[1.1fr_1fr] lg:items-end lg:gap-14 lg:pb-16">
    <div>
      <p class={`eyebrow vt-${entry.id.split('/')[1]}`}>{entry.data.title}</p>
      <h1 class="display-page mt-4">{entry.data.headline}</h1>
      <p class="mt-6 max-w-xl text-xl">{entry.data.summary}</p>
    </div>
    <RoomCrop id={entry.id} />
  </section>

  <section class="wrap grid gap-12 pb-16 md:pb-24 lg:grid-cols-[1.5fr_1fr]">
    <div class="prose-body"><Content /></div>
    <aside class="card-cta band">
      <h2 class="display-md">{entry.data.cta}</h2>
      <p class="mt-3">Call us, or send a few details and we'll get back to you.</p>
      <a href={site.phoneHref} class="btn btn-hivis mt-6 w-full">Call {site.phone}</a>
      <a href="/contact/" class="btn btn-line mt-3 w-full">Send an enquiry</a>
    </aside>
  </section>

  {entry.data.testimonial && (
    <section class="wrap max-w-5xl pb-16 md:pb-24">
      <Quote id={entry.data.testimonial} />
    </section>
  )}

  <section class="wrap pb-16 md:pb-24">
    <p class="eyebrow mb-4">Also {group.label.toLowerCase()}</p>
    <ul class="grid gap-x-10 sm:grid-cols-2">
      {related.map((s) => (
        <li class="border-b border-line">
          <a href={`/${s.id}/`} class="plain-row">{s.data.title}<span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
  </section>

  <CallBand />
</Base>
