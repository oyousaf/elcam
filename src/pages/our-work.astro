---
import Base from '../layouts/Base.astro';
import CallBand from '../components/CallBand.astro';
import Quote from '../components/Quote.astro';

const jobs = [
  {
    sector: 'Home',
    title: 'Side and rear kitchen extension',
    scope: ['Ground works', 'Structural steel work', 'Electrical work', 'Underfloor heating', 'Complete kitchen fit', 'All plumbing', 'Floor and wall tiling'],
  },
  {
    sector: 'Home',
    title: 'Partition removal and kitchen refurbishment',
    scope: ['Partition removal', 'Kitchen refurbishment', 'All plumbing', 'All electrical work'],
  },
  {
    sector: 'Home',
    title: 'Kitchen extension with flat roof and lantern',
    scope: ['Timber flat roof', 'Steel beam', 'Roof lantern', 'Kitchen extension'],
  },
  {
    sector: 'Business',
    title: 'New meeting rooms and conference suite',
    scope: ['Built to client plans', 'Modifications during the job', 'Completed on time', 'Completed within budget'],
  },
];
---
<Base title="Our work" description="A selection of extensions, kitchen refurbishments and commercial fit-outs carried out by Elcam Property Maintenance in and around Milton Keynes.">
  <section class="wrap py-12 md:py-16">
    <p class="eyebrow">Our work</p>
    <h1 class="display-hero mt-4">Jobs large and small</h1>
    <ul class="jobs mt-12">
      {jobs.map((job, i) => (
        <li class="job">
          <p class="job-tag"><span>Job sheet {String(i + 1).padStart(2, '0')}</span><span>{job.sector}</span></p>
          <h2 class="display-md mt-4">{job.title}</h2>
          <ul class="job-scope">
            {job.scope.map((item) => <li>{item}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </section>
  <section class="wrap grid gap-8 pb-16 md:pb-24 lg:grid-cols-2">
    <Quote id="fitout" />
    <Quote id="decorating" />
  </section>
  <CallBand title="Planning something similar?" />
</Base>
