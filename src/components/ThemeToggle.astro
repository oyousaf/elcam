---
const options = [
  { value: 'device', label: 'Device', icon: '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M9 20h6M12 16v4"/>' },
  { value: 'light', label: 'Light', icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>' },
  { value: 'dark', label: 'Dark', icon: '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/>' },
];
---
<fieldset class="theme-toggle">
  <legend class="sr-only">Colour theme</legend>
  {options.map((option) => (
    <label title={option.label}>
      <input type="radio" name="theme" value={option.value} checked={option.value === 'device'} class="sr-only" />
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" set:html={option.icon} />
      <span class="sr-only">{option.label}</span>
    </label>
  ))}
</fieldset>

<script>
  import '../scripts/theme';
</script>
